				; -------------------------------------------------------------------------
				; Name: main
				; 
				; Program entry point where procedures are called to display introduction,
				; get user input, print pascal triangle, and display departing message.
				; -------------------------------------------------------------------------
 00000000			main PROC
 00000000  E8 00000016			call	introduction
 00000005  E8 00000030			call	getUserInput
 0000000A  E8 00000056			call	printPascalTriangle
 0000000F  E8 000000B2			call	farewell
					Invoke	ExitProcess,0
 00000014  6A 00	   *	    push   +000000000h
 00000016  E8 00000000 E   *	    call   ExitProcess
 0000001B			main ENDP

				; -------------------------------------------------------------------------
				; Name: introduction
				; 
				; Introduce the program title and introduction to the user.
				;
				; Preconditions: programTitle, programIntro, and extraCredit2 are defined
				;
				; Postconditions: EDX is changed
				;
				; Receives:
				;		programTitle, programIntro, extraCredit2 are global variables
				; -------------------------------------------------------------------------
 0000001B			introduction PROC
 0000001B  BA 00000000 R		mov		edx, OFFSET programTitle
 00000020  E8 00000000 E		call	WriteString
 00000025  BA 0000002D R		mov		edx, OFFSET programIntro
 0000002A  E8 00000000 E		call	WriteString
 0000002F  BA 00000082 R		mov		edx, OFFSET extraCredit2
 00000034  E8 00000000 E		call	WriteString
 00000039  C3				ret
 0000003A			introduction ENDP

				; -------------------------------------------------------------------
				; Name: getUserInput
				; 
				; Gets and validates an integer from the user within the range 1-20.
				;
				; Postconditions: EAX, EDX are changed
				;
				; Receives: 
				;		ROWS_MIN = minimum row value boundary
				;		ROWS_MAX = maximum row value boundary
				;		rowInputPrompt, errorMessage are global variables
				;
				; Returns: userInput = row integer value
				; -------------------------------------------------------------------
 0000003A			getUserInput PROC
					; Prompt the user for an integer.
 0000003A				_getInput:
 0000003A  BA 000000C4 R			mov		edx, OFFSET rowInputPrompt
 0000003F  E8 00000000 E			call	WriteString
 00000044  E8 00000000 E			call	ReadInt
 00000049  83 F8 01				cmp		eax, ROWS_MIN				; check user input is >= 1
 0000004C  7C 0B				jl		_error
 0000004E  83 F8 14				cmp		eax, ROWS_MAX				; check user input is <= 20
 00000051  7F 06				jg		_error
 00000053  A3 0000015F R			mov		userInput, eax
 00000058  C3					ret
					; Display an error message if input is outside 1-20 range.
 00000059				_error:
 00000059  BA 000000F3 R			mov		edx, OFFSET errorMessage
 0000005E  E8 00000000 E			call	WriteString
 00000063  EB D5				jmp		_getInput
 00000065			getUserInput ENDP

				; ------------------------------------------------------------
				; Name: printPascalTriangle
				; 
				; Prints pascal triangle based on row count from user input 
				; until all rows are printed.
				;
				; Preconditions: userInput contains validated row input value
				;
				; Postconditions: ECX is changed
				;
				; Receives: userInput = row integer value
				; ------------------------------------------------------------
 00000065			printPascalTriangle PROC
 00000065  E8 00000000 E		call	CrLf
 0000006A  8B 0D 0000015F R		mov		ecx, userInput
					; Loop through each row sequentially while preserving the outer loop counter.
 00000070				_printRow:
 00000070  51					push	ecx
 00000071  E8 00000004				call	printPascalRow
 00000076  59					pop		ecx
 00000077  E2 F7				loop	_printRow
 00000079  C3				ret
 0000007A			printPascalTriangle ENDP

				; -----------------------------------------------------------------------------
				; Name: printPascalRow
				; 
				; Displays a single row of the Pascal triangle with proper values and spacing.
				;
				; Preconditions: ECX contains current outer loop countdown value
				;
				; Postconditions: EAX, EBX, EDX, ESI, and EDI are changed
				;
				; Receives:
				;		ECX = current loop countdown index
				;		userInput = row integer value
				; ------------------------------------------------------------------------------
 0000007A			printPascalRow PROC
					; Calculate the current row number 'n' based on the loop counter countdown and initialize 'k' index counter to 0.
 0000007A  A1 0000015F R		mov		eax, userInput
 0000007F  2B C1			sub		eax, ecx			; eax = current row 'n'
 00000081  8B D8			mov		ebx, eax			; ebx = n value
 00000083  BF 00000000			mov		edi, 0				; edi = k counter
					
 00000088				_rowLoop:
 00000088  3B FB				cmp		edi, ebx		; check k <= n
 0000008A  7F 11				jg		_finished

 0000008C  8B C7				mov		eax, edi		; eax = k
 0000008E  E8 00000010				call	nChooseK         
					
 00000093  B0 20				mov		al, ' '
 00000095  E8 00000000 E			call	WriteChar

 0000009A  47					inc		edi				; increase k for next nCk value
 0000009B  EB EB				jmp		_rowLoop

 0000009D				_finished:
 0000009D  E8 00000000 E			call	CrLf
 000000A2  C3					ret
 000000A3			printPascalRow ENDP

				; --------------------------------------------------------------------------
				; Name: nChooseK
				; 
				; Calculates and prints the current Pascal triangle element value using
				; the multiplicative formula for nCk.
				;
				; Preconditions: EAX has k value, EBX has n value.
				;
				; Postconditions: EAX, EDX, and ESI are changed. EBX and ECX are preserved.
				;
				; Receives: 
				;		EAX = 'k' index value
				;		EBX = 'n' row value
				;
				; Returns: Calculated decimal value is printed onto console.
				; ---------------------------------------------------------------------------
 000000A3			nChooseK PROC
					; Preserve EBX/ECX registers. Setup multiplier/divisor with value '1'.
 000000A3  53				push	ebx
 000000A4  51				push	ecx
 000000A5  8B C8			mov		ecx, eax			; loop counter 'k' (limit)
 000000A7  B8 00000001			mov		eax, 1				; multiplier
 000000AC  BE 00000001			mov		esi, 1				; divisor
 000000B1  83 F9 00			cmp		ecx, 0				; skip loop if k=0
 000000B4  74 08			je		_printValue
					; Calculate element value by multiplying 'n' values and dividing by 'k' values using multiplicative formula.
 000000B6				_calculate:
 000000B6  F7 E3				mul		ebx				; edx:eax = total * n
 000000B8  F7 F6				div		esi				; eax = total / divisor
 000000BA  4B					dec		ebx
 000000BB  46					inc		esi
 000000BC  E2 F8				loop	_calculate
					; Print calculated element value and restore registers.
 000000BE				_printValue:
 000000BE  E8 00000000 E			call	WriteDec
 000000C3  59					pop		ecx
 000000C4  5B					pop		ebx
 000000C5  C3					ret
 000000C6			nChooseK ENDP

				; -----------------------------------------------
				; Name: farewell
				;
				; Displays a goodbye message to the user.
				;
				; Preconditions: farewellMessage is defined
				;
				; Postconditions: EDX is changed
				;
				; Receives: farewellMessage is a global variable
				; -----------------------------------------------
 000000C6			farewell PROC
 000000C6  E8 00000000 E		call	CrLf
 000000CB  BA 00000127 R		mov		edx, OFFSET farewellMessage
 000000D0  E8 00000000 E		call	WriteString
 000000D5  C3				ret
 000000D6			farewell ENDP

				END main
